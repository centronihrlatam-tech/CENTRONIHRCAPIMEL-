# ── clasp ─────────────────────────────────────────────────────────────
# Contiene el scriptId de TU proyecto. Nunca se versiona:
# cada persona que clone el repo genera el suyo a partir de
# .clasp.json.example
.clasp.json
.clasprc.json

# ── Credenciales y secretos ───────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json
client_secret*.json
service-account*.json
token.json

# ── Dependencias ──────────────────────────────────────────────────────
node_modules/
package-lock.json
yarn.lock

# ── Sistema operativo ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editores ──────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~

# ── Temporales y respaldos ────────────────────────────────────────────
*.log
*.bak
*.tmp

# -- Datos privados del despliegue -------------------------------------
# Identificadores de Drive/Sheets, catalogos con datos personales y
# cualquier volcado de datos reales. Ningun proyecto debe versionarlos.
local/
*.local.gs
*.local.json
# Ojo: patron acotado a propósito. 'secrets*' tambien ocultaria un modulo
# legitimo llamado secrets.py, que es codigo y debe versionarse.
secrets.json
secrets.yaml
secrets.yml
.secrets/
credentials*.json

# -- Exportaciones y respaldos de datos reales ------------------------
*.csv
# ...excepto las plantillas de estructura (sin datos reales):
!apps/registro-personal/templates/*.csv
*.xlsx
*.zip
_BACKUP*/
backup*/
