# Copy to .env and fill in. .env is git-ignored.
# Never commit real values.

# --- Google Docs template to clone for each report -------------------------
REPORT_TEMPLATE_ID=

# --- Optional: Google service account (leave empty to use ADC / Colab auth) -
GOOGLE_APPLICATION_CREDENTIALS=

# --- LLM provider key (only needed when llm.enabled = true) ----------------
OPENAI_API_KEY=

# --- Optional: roster stored in a Sheet instead of a local CSV -------------
ROSTER_SHEET_ID=
